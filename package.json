{
  "name": "jupiter-sdk",
  "version": "0.0.0",
  "description": "Jupiter on-chain product SDKs",
  "keywords": [
    "codama",
    "defi",
    "jupiter",
    "sdk",
    "solana",
    "web3"
  ],
  "homepage": "https://github.com/ChiefWoods/jupiter-sdk",
  "bugs": {
    "url": "https://github.com/ChiefWoods/jupiter-sdk/issues"
  },
  "license": "MIT",
  "author": "Jupiter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChiefWoods/jupiter-sdk.git"
  },
  "workspaces": [
    "src/products/*"
  ],
  "type": "module",
  "exports": {},
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "generate": "bun src/scripts/generate.ts",
    "generate:codama-idl": "bun src/scripts/generate-codama-idl.ts",
    "generate:clients": "bun src/scripts/generate-clients.ts",
    "generate:cargo-toml": "bun src/scripts/generate-cargo-toml.ts",
    "generate:package-json": "bun src/scripts/generate-package-json.ts",
    "generate:tsconfig-json": "bun src/scripts/generate-tsconfig-json.ts",
    "generate:tsdown": "bun src/scripts/generate-tsdown.ts",
    "prepare": "husky",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.2",
    "@codama/renderers-js": "^2.3.0",
    "@codama/renderers-rust": "^3.1.1",
    "@types/bun": "^1.3.14",
    "codama": "^1.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "renderers-web3js": "^0.3.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
