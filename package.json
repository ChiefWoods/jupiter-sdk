    "@types/bun": "^1.3.14",
    "codama": "^1.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "renderers-web3js": "^0.3.1",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7"
