{
  "name": "@jupiter/sdk",
  "private": true,
  "workspaces": [
    "src/products/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish",
    "generate:codama-idl": "bun src/scripts/generate-codama-idl.ts",
    "generate:clients": "bun src/scripts/generate-clients.ts",
    "generate:cargo-toml": "bun src/scripts/generate-cargo-toml.ts",
    "generate:package-json": "bun src/scripts/generate-package-json.ts",
    "generate:tsconfig-json": "bun src/scripts/generate-tsconfig-json.ts",
    "generate:tsdown": "bun src/scripts/generate-tsdown.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@codama/nodes-from-anchor": "^1.5.2",
    "@codama/renderers-js": "^2.3.0",
    "@codama/renderers-rust": "^3.1.1",
    "@types/bun": "^1.3.14",
    "codama": "^1.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "renderers-web3js": "^0.3.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
