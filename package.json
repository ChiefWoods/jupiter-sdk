    "typecheck": "turbo typecheck",
    "generate": "bun src/scripts/generate.ts",
    "generate:codama-idl": "bun src/scripts/generate-codama-idl.ts",
    "generate:clients": "bun src/scripts/generate-clients.ts",
    "generate:cargo-toml": "bun src/scripts/generate-cargo-toml.ts",
    "generate:package-json": "bun src/scripts/generate-package-json.ts",
    "generate:tsconfig-json": "bun src/scripts/generate-tsconfig-json.ts",
    "generate:tsdown": "bun src/scripts/generate-tsdown.ts",
    "prepare": "husky",
    "prepublishOnly": "bun run typecheck && bun run build"
